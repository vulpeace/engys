{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "engys",
  "version": "../package.json",
  "identifier": "top.vulpeace.engys",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "engys",
        "visible": false,
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["engys"] },
      "mobile": [{ "scheme": ["engys"], "host": "import-sub", "appLink": false }]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "vulpeace",
    "homepage": "https://github.com/vulpeace/engys",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/login-cleanup.wxs"
        ],
        "componentGroupRefs": [
          "MihomoLoginCleanup"
        ]
      }
    }
  }
}
