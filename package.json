	"repository": {
		"type": "git",
		"url": "git+https://github.com/vulpeace/engys.git"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "tauri build",
		"build:frontend": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"android:init": "tauri android init",
		"android:dev": "tauri android dev",
		"android:build": "tauri android build --target aarch64 x86_64"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.5",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lucide/svelte": "^1.75.0",
		"@tauri-apps/api": "^2.12.5",
		"@tauri-apps/plugin-dialog": "^2.8.4",
